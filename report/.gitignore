# =========================
# EcoShield AI - .gitignore
# =========================

# --- OS / File Explorer ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# --- IDEs / Editors ---
.vscode/
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
.pyre/
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Python packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Machine Learning / AI ---
# Model weights and checkpoints
*.pt
*.pth
*.onnx
*.tflite
*.engine
*.ckpt
*.safetensors
checkpoints/
weights/
models/
runs/
wandb/
mlruns/

# Training / evaluation outputs
outputs/
predictions/
inference_results/
tensorboard/
logs/

# Datasets (usually too large for Git)
data/
datasets/
raw_data/
processed_data/
*.zip
*.tar
*.tar.gz

# --- Computer Vision ---
*.jpg
*.jpeg
*.png
*.bmp
*.tif
*.tiff
*.webp
# Keep selected documentation images if desired:
# !docs/images/*.png

# --- ROS2 ---
install/
log/
build/
.colcon/
*.bag
*.db3
rosbags/

# --- Flutter / Dart ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/

# Android generated files
android/.gradle/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
*.keystore
*.jks

# iOS generated files
ios/Pods/
ios/.symlinks/
ios/Flutter/ephemeral/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh

# --- Node.js / Backend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.next/
.nuxt/
dist/

# --- Java / Spring Boot (if backend components are added) ---
target/
*.class
*.jar
*.war
*.ear
.gradle/
.settings/
.classpath
.project
.factorypath

# --- C / C++ / Embedded ---
*.o
*.obj
*.elf
*.hex
*.bin
*.map
*.lst
*.d
cmake-build-*/
CMakeFiles/
CMakeCache.txt
Makefile
compile_commands.json

# PlatformIO
.pio/
.piolibdeps/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/tasks.json

# Arduino
*.hex
*.eep
*.elf

# --- STM32 / ESP32 / Firmware generated files ---
*.axf
*.map
*.list
*.bin
*.out

# --- PCB / CAD temporary files ---
# Keep source PCB/CAD files under version control; ignore generated outputs.
*.bak
*.lck
*.tmp
~$*
AutoSave/
gerber/
gerbers/
drill/
fabrication_output/

# --- LTspice / Simulation outputs ---
*.raw
*.fft
*.log
*.net
*.op.raw
*.ac.raw
*.tran.raw
*.meas
*.plt

# --- MATLAB ---
*.asv
*.m~
*.slxc
*.mex*
codegen/
*.mlproj

# --- Secrets / Credentials ---
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/
config.local.*
firebase-service-account*.json

# --- Local databases ---
*.sqlite
*.sqlite3
*.db

# --- Logs / Runtime ---
*.log
logs/
tmp/
temp/
.cache/

# --- LaTeX ---
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.run.xml
*.synctex
*.synctex.gz
*.toc
*.nav
*.snm
*.vrb

# Keep the proposal source and references:
# *.tex
# *.bib
# *.pdf

# --- Documentation build outputs ---
_site/
public/

# --- Large media / recordings ---
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.mp3

# --- Local deployment / Docker ---
docker-compose.override.yml
*.local.yml
*.local.yaml

# --- Cloud / deployment credentials ---
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# --- General generated files ---
generated/
artifacts/
release/
releases/
